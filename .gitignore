# NukeUtils — build products and generated output. The SOURCES are the repo
# (nukegen.py, nukeicons.py, stage_release.ps1, NukeGen/nukegen.cpp + CMakeLists);
# everything below is reproduced by the superbuild.

# NukeGen deploy target (the superbuild copies the exe here; SDK staging reads it)
/bin/

# NukeGen standalone configure tree (cmake -S NukeGen -B NukeGen/build)
/NukeGen/build/

# Generated cross-module SDK wrappers (nukegen --sdk) and API docs (nukegen --doc);
# regenerated by every module build, staged into dist\<Config>\sdk by stage_release -Sdk
/sdk/
/sdkdocs/
